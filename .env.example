# acquire-gov — environment template
# Copy to .env and fill in real values. .env is git-ignored.

# --- Auth / JWT ---
JWT_ISSUER_URI=http://localhost:8090/auth
JWT_AUDIENCE=acquire-gov

# --- Datastores ---
POSTGRES_URL=jdbc:postgresql://localhost:5432/acquire_gov
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password

MONGO_URL=mongodb://app:app_dev_password@localhost:27017
MONGO_DB=acquire_gov

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Stronger model used on confidence-fail draft fallback (ADR-0006). Defaults to a
# Sonnet id in bedrock_client if left blank.
BEDROCK_FALLBACK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0

# --- RAG retrieval layer (ADR-0005 Phase 1) ---
# Embeddings — Titan V2, 512 dims (ADR-0005 §3). Embedding pipeline requires
# Bedrock credentials above to be explicitly enabled by the team.
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=512
EMBEDDING_MODEL_VERSION=v2
# Vector store — MongoDB Atlas Local (ADR-0005 §2)
FAR_CORPUS_COLLECTION=far_corpus
RETRIEVAL_AUDIT_COLLECTION=retrieval_audit
EMBEDDING_CACHE_COLLECTION=embedding_cache
FAR_VECTOR_INDEX=far_vector_idx
FAR_TEXT_INDEX=far_text_idx
# Re-ranker — local cross-encoder, no API cost (ADR-0005 §5)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Inter-service ---
API_GATEWAY_URL=http://localhost:8080
SOLICITATION_SERVICE_URL=http://localhost:8081
EVALUATION_SERVICE_URL=http://localhost:8082
AI_ORCHESTRATOR_URL=http://localhost:8000

# LangSmith Setup
# WARNING: setting LANGSMITH_TRACING=true sends prompts and execution traces
# (including CO change statements and contract data) to LangSmith's external SaaS.
# This is a data-egress decision — do NOT enable in shared/prod environments without
# explicit SBU/FedRAMP sign-off from your security officer.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT="contract-payment"
